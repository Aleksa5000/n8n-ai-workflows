# Copy to .env (git-ignored). Everything is optional: the defaults run the demo against the mock service.

# --- host ports (loopback only) ---
N8N_HOST_PORT=5679
MOCK_HOST_PORT=8795
GENERIC_TIMEZONE=UTC

# --- optional: owner account for the LOCAL demo instance only (used by scripts/setup_demo_owner.sh) ---
DEMO_OWNER_EMAIL=demo-owner@example.com
DEMO_OWNER_PASSWORD=Demo-Local-7f3kQ9xW2

# --- production: point the workflows at real services (credentials themselves live in n8n, not here) ---
# ERROR_ALERT_CHANNEL=slack            # slack | telegram | demo
# NOTIFY_CHANNEL=slack                 # slack | telegram (urgent emails + daily digest)
# SLACK_CHANNEL_EMAIL=C0123456789      # Slack channel IDs
# SLACK_CHANNEL_SUPPORT=C0123456789
# SLACK_CHANNEL_LEADS=C0123456789
# SLACK_CHANNEL_ALERTS=C0123456789
# TELEGRAM_CHAT_ID=
# TRIAGE_SHEET_ID=                     # Google Sheet IDs (the long id in the sheet URL)
# SUPPORT_SHEET_ID=
# KB_SEARCH_URL=https://rag.example.com/api/chat   # docs-rag-assistant, or any search endpoint (see README)
# KB_API_KEY=                          # sent as X-API-Key if your KB needs it
# KB_MIN_SCORE=0.4                     # use ~4 for docs-rag-assistant (BM25 scores are not 0..1; see README)
# ANSWER_MIN_CONFIDENCE=0.6
# CRM_BASE_URL=https://api.hubapi.com
# LEAD_WEBHOOK_SECRET=                 # if set, the form must send it as the X-Webhook-Secret header
# ANTHROPIC_MODEL=claude-haiku-5-5
