    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Demo entry point: a sample email POSTed to the webhook is turned into the same fields\n// that \"Normalize email\" produces from the Gmail Trigger, so everything after this node is identical.\nconst b = $input.first().json.body || {};\nconst raw = String(b.from || '');\nconst m = raw.match(/^\\s*\"?([^\"<]*?)\"?\\s*<([^>]+)>\\s*$/); // \"Name <addr@x.com>\" or a bare address\n\nreturn [\n  {\n    json: {\n      message_id: String(b.message_id || 'demo-' + Date.now()),\n      thread_id: String(b.thread_id || 'thread-' + Date.now()),\n      from_email: (m ? m[2] : raw).trim().toLowerCase(),\n      from_name: m ? m[1].trim() : '',\n      subject: String(b.subject || '(no subject)').slice(0, 300),\n      body: String(b.body || '').slice(0, 6000),\n      received_at: new Date().toISOString(),\n      simulate: b.simulate_classifier || null, // lets the demo feed the validator bad \"LLM\" output on purpose\n    },\n  },\n];\n"
      },
      "id": "d62f758e-2aa7-59d4-978a-5e0221dbd164",
      "name": "Normalize email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MOCK_BASE_URL + '/classify' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from_email: $json.from_email, from_name: $json.from_name, subject: $json.subject, body: $json.body, simulate: $json.simulate }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "f3b5e388-abaf-5f14-80cd-b86c78f618f2",
      "name": "Classify (fake classifier, no LLM)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        480,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Never trust model output. Parse it, check it against the schema, and fall back to \"Routine\"\n// (no draft, flagged for a human) when anything is wrong. One result per email, in input order.\nconst CATEGORIES = ['Urgent', 'Important', 'Client', 'Billing', 'Routine', 'Informational', 'Low Value'];\nconst FALLBACK = 'Routine';\nconst emails = $('Normalize email').all();\n\nfunction parse(raw) {\n  if (typeof raw !== 'string') return raw;\n  const m = raw.match(/\\{[\\s\\S]*\\}/); // tolerate prose or code fences around the JSON\n  if (!m) return null;\n  try {\n    return JSON.parse(m[0]);\n  } catch (e) {\n    return null;\n  }\n}\n\nfunction check(c) {\n  if (!c || typeof c !== 'object' || Array.isArray(c)) return ['output is not a JSON object'];\n  const errors = [];\n  if (!CATEGORIES.includes(c.category)) errors.push('category must be one of ' + CATEGORIES.join(', '));\n  if (typeof c.confidence !== 'number' || !(c.confidence >= 0 && c.confidence <= 1)) errors.push('confidence must be a number from 0 to 1');\n  if (typeof c.summary !== 'string' || !c.summary.trim()) errors.push('summary must be a non-empty string');\n  if (typeof c.needs_reply !== 'boolean') errors.push('needs_reply must be a boolean');\n  if (typeof c.reply_draft !== 'string') errors.push('reply_draft must be a string');\n  return errors;\n}\n\nreturn $input.all().map((item, i) => {\n  const email = emails[i].json;\n  const raw = item.json.output !== undefined ? item.json.output : item.json;\n  const c = parse(raw);\n  const errors = check(c);\n  const ok = errors.length === 0;\n  const draft = ok && c.needs_reply ? c.reply_draft.trim().slice(0, 4000) : '';\n  return {\n    json: {\n      message_id: email.message_id,\n      thread_id: email.thread_id,\n      from_email: email.from_email,\n      from_name: email.from_name,\n      subject: email.subject,\n      received_at: email.received_at,\n      category: ok ? c.category : FALLBACK,\n      confidence: ok ? c.confidence : 0,\n      summary: ok ? c.summary.trim().slice(0, 300) : 'Automatic classification failed validation; please triage manually.',\n      reason: ok ? String(c.reason || '').slice(0, 200) : '',\n      needs_reply: draft.length > 0,\n      reply_draft: draft,\n      fallback: !ok,\n      validation_errors: errors.join('; '),\n    },\n  };\n});\n"
      },
      "id": "1daa3670-82fe-5711-b632-09a40d5327f1",
      "name": "Validate classification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
