    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Reduce today's rows of the triage log to the numbers the digest needs.\nconst today = $now.toFormat('yyyy-MM-dd');\nconst truthy = (v) => String(v).toLowerCase() === 'true';\nconst rows = $input.all().map((i) => i.json).filter((r) => r['Date'] === today);\n\nconst counts = {};\nfor (const r of rows) counts[r['Category']] = (counts[r['Category']] || 0) + 1;\n\nreturn [\n  {\n    json: {\n      date: today,\n      total: rows.length,\n      counts,\n      needs_reply: rows.filter((r) => truthy(r['Needs Reply'])).length,\n      fallbacks: rows.filter((r) => truthy(r['Fallback'])).length,\n      urgent: rows\n        .filter((r) => r['Category'] === 'Urgent')\n        .slice(0, 10)\n        .map((r) => ({ from: r['From'], subject: r['Subject'], summary: r['Summary'] })),\n    },\n  },\n];\n"
      },
      "id": "24a62a9f-700a-5e2e-b059-27bf542d45a3",
      "name": "Build digest data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        1100
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Demo only: the production workflow asks Claude to write the digest; here it is a plain template.\nconst d = $input.first().json;\nconst lines = [`Daily inbox digest for ${d.date}: ${d.total} emails triaged.`];\nconst parts = Object.entries(d.counts).map(([k, v]) => `${k}: ${v}`);\nif (parts.length) lines.push(parts.join(', '));\nlines.push(`${d.needs_reply} need a reply (drafts are waiting in Gmail), ${d.fallbacks} fell back to Routine.`);\nfor (const u of d.urgent) lines.push(`URGENT - ${u.from}: ${u.subject}`);\nreturn [{ json: { ...d, text: lines.join('\\n') } }];\n"
      },
      "id": "49e898f4-31fc-5a3d-80b1-33e62175d5e4",
