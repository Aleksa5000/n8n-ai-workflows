    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"score\",\n    \"intent\",\n    \"reason\"\n  ],\n  \"properties\": {\n    \"score\": {\n      \"type\": \"integer\",\n      \"minimum\": 0,\n      \"maximum\": 100\n    },\n    \"intent\": {\n      \"type\": \"string\"\n    },\n    \"reason\": {\n      \"type\": \"string\",\n      \"maxLength\": 300\n    }\n  }\n}",
        "autoFix": false
      },
      "id": "2e9691ad-6533-567b-ac57-fb2fee58f54c",
      "name": "Lead JSON schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1100,
        880
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// The tier is derived from the number here, never taken from the model.\n// An invalid answer does NOT drop the lead: it is stored as \"unscored\" for a human to review.\nconst lead = $('Dedupe check').first().json.lead;\nconst HOT = Number($env.LEAD_HOT_SCORE || 70);\nconst WARM = Number($env.LEAD_WARM_SCORE || 40);\nconst item = $input.first().json;\n\nfunction parse(raw) {\n  if (typeof raw !== 'string') return raw;\n  const m = raw.match(/\\{[\\s\\S]*\\}/);\n  if (!m) return null;\n  try {\n    return JSON.parse(m[0]);\n  } catch (e) {\n    return null;\n  }\n}\n\nconst c = parse(item.output !== undefined ? item.output : item);\nconst valid =\n  c && typeof c === 'object' && typeof c.score === 'number' && Number.isFinite(c.score) &&\n  c.score >= 0 && c.score <= 100 && typeof c.reason === 'string' && c.reason.trim().length > 0;\nconst score = valid ? Math.round(c.score) : 0;\nconst tier = !valid ? 'unscored' : score >= HOT ? 'hot' : score >= WARM ? 'warm' : 'cold';\n\nreturn [\n  {\n    json: {\n      lead,\n      score,\n      tier,\n      reason: valid ? c.reason.trim().slice(0, 300) : 'AI scoring failed validation; review this lead manually.',\n      scoring_failed: !valid,\n    },\n  },\n];\n"
      },
      "id": "9a6f0aa4-3b91-597d-b031-7147d7263d9d",
      "name": "Validate score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1260,
        660
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// HubSpot-style contact properties. Empty values are left out so an update never blanks existing CRM data.\n// ai_lead_score, ai_lead_tier, ai_lead_reason and lead_source are custom properties: create them in the CRM first.\nconst d = $input.first().json;\nconst l = d.lead;\nconst all = {\n  email: l.email,\n  firstname: l.firstname,\n  lastname: l.lastname,\n  company: l.company,\n  phone: l.phone,\n  message: l.message,\n  lead_source: l.source,\n  ai_lead_score: d.score,\n  ai_lead_tier: d.tier,\n  ai_lead_reason: d.reason,\n};\nconst crm_properties = Object.fromEntries(Object.entries(all).filter(([, v]) => v !== '' && v != null));\nreturn [{ json: { ...d, crm_properties } }];\n"
      },
